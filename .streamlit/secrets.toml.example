# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml แล้วใส่ค่าจากไฟล์ .txt ของ Neo4j Aura
# ห้าม commit secrets.toml ลง GitHub

[neo4j]
uri = "neo4j+s://xxxxxxxx.databases.neo4j.io"   # NEO4J_URI
username = "xxxxxxxx"                           # NEO4J_USERNAME
password = "YOUR_PASSWORD"                      # NEO4J_PASSWORD
# database = "xxxxxxxx"                         # ไม่ต้องใส่ก็ได้ จะใช้ home database
